# =============================================================================
# Evercrest Health — Streamlit Community Cloud secrets template
# =============================================================================
# HOW TO USE
#   • Streamlit Cloud: open the app → Settings → Secrets, and paste the contents
#     below with REAL values filled in. Streamlit writes this to
#     .streamlit/secrets.toml for the running app.
#   • Local run: copy this file to ".streamlit/secrets.toml" and fill it in.
#
# NEVER commit a filled-in secrets.toml. Only this *.template belongs in git.
# The real GALILEO_API_KEY lives in 1Password (item "EHR Assistant"); OpenAI /
# Postgres are separate items. Pull them with `op`/`op inject`, or paste here.
# =============================================================================

# Open the app straight on the Evercrest EHR (the "/" route).
default_domain = "healthcare"

# ---- OpenAI (hosted chat + embeddings) --------------------------------------
openai_api_key = "REPLACE_ME"          # from 1Password
openai_default_chat_model = "gpt-4o"
openai_embedding_model = "text-embedding-3-large"
openai_embedding_dimensions = 768

# ---- Galileo (logging, cloud links, Agent Control) --------------------------
galileo_api_key = "REPLACE_ME"         # from 1Password item "EHR Assistant"
galileo_console_url = "https://console.demo-v2.galileocloud.io/"
# Point all traces at the EHR Assistant project / chart-agent log stream.
galileo_project = "EHR Assistant"
galileo_log_stream = "chart-agent"
# Derived from galileo_console_url when omitted:
# galileo_api_url = "https://api.demo-v2.galileocloud.io"
# agent_control_url = "https://console.demo-v2.galileocloud.io/api/agent-control"
agent_control_agent_name = "ehr-assistant-agent"
agent_control_runtime_auth_mode = "jwt"
agent_control_api_key_header = "Galileo-API-Key"
agent_control_target_type = "log_stream"

# ---- PostgreSQL + pgvector (SHARED Neon backend) ----------------------------
# Use the SAME Neon connection URL as the main golden-demo deployment — the
# healthcare tables + RAG index already live there, so DO NOT re-run
# setup_vectordb.py. Copy it from the existing app's Streamlit Cloud Secrets
# (or 1Password). Use the POOLED Neon URL with ?sslmode=require.
postgres_url = "postgresql://USER:PASSWORD@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# ---- Optional ----------------------------------------------------------------
admin_key = ""                          # authorizes deleting experiments in the UI
environment = "hosted"
