# Evercrest Streamlit Community Cloud configuration.
# Paste real values into the app's Advanced settings -> Secrets field.
# Never commit .streamlit/secrets.toml.

default_domain = "healthcare"

# OpenAI chat and embeddings
openai_api_key = "..."
openai_default_chat_model = "gpt-4o"
openai_embedding_model = "text-embedding-3-large"
openai_embedding_dimensions = 768

# Galileo logging and Agent Control
galileo_api_key = "..."
galileo_console_url = "https://console....galileocloud.io/"
galileo_project = "evercrest-demo"
galileo_log_stream = "healthcare"
# These are derived from galileo_console_url when omitted.
# galileo_api_url = "https://api....galileocloud.io"
# agent_control_url = "https://console....galileocloud.io/api/agent-control"
agent_control_agent_name = "evercrest-demo-agent"
agent_control_runtime_auth_mode = "jwt"
agent_control_api_key_header = "Galileo-API-Key"
agent_control_target_type = "log_stream"

# Network-reachable PostgreSQL with the pgvector extension enabled.
# Use a direct connection for the one-time initializer and a pooled connection
# for the Streamlit runtime when your provider offers both.
postgres_url = "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional authorization for deleting experiments from the UI.
admin_key = ""
