# =============================================================================
# Evercrest Health — dotenv template (shareable, NO real secrets)
# =============================================================================
# Copy to a private "evercrest.env" (or repo-root ".env"), fill in the real
# values, then `chmod 600` it. python-dotenv loads a repo-root .env at startup,
# so this doubles as a local run config.
#
# The real GALILEO_API_KEY lives in 1Password (item "EHR Assistant"); OpenAI /
# Postgres are separate items. Prefer the 1Password flow over typing keys:
#   op inject -i config/evercrest/evercrest.env.op.example -o .env
# (see evercrest.env.op.example). NEVER commit a filled-in .env.
# =============================================================================

# Open the app straight on the Evercrest EHR ("/").
DEFAULT_DOMAIN=healthcare

# ---- OpenAI (hosted chat + embeddings) ----
OPENAI_API_KEY=
OPENAI_DEFAULT_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=768

# ---- Galileo (logging, cloud links, Agent Control) ----
GALILEO_API_KEY=
GALILEO_CONSOLE_URL=https://console.demo-v2.galileocloud.io/
GALILEO_PROJECT="EHR Assistant"
GALILEO_LOG_STREAM=chart-agent
AGENT_CONTROL_AGENT_NAME=ehr-assistant-agent
AGENT_CONTROL_RUNTIME_AUTH_MODE=jwt
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
AGENT_CONTROL_TARGET_TYPE=log_stream

# ---- PostgreSQL + pgvector (SHARED Neon backend) ----
# Same Neon URL as the main golden-demo deployment (tables + index already
# loaded — do NOT re-seed). Use the POOLED url at runtime.
POSTGRES_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# ---- Optional ----
ADMIN_KEY=
ENVIRONMENT=hosted
