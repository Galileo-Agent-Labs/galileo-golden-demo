# =============================================================================
# Evercrest Health — 1Password `op inject` template
# =============================================================================
# Resolves the real secrets from 1Password into a private .env WITHOUT any key
# ever being typed or committed:
#
#   op signin
#   op inject -i config/evercrest/evercrest.env.op.example -o .env
#   chmod 600 .env
#
# Then run locally (python-dotenv picks up .env), or paste the equivalent values
# into Streamlit Cloud → Settings → Secrets (see .streamlit/secrets.evercrest.toml.template).
#
# Replace <VAULT> with your 1Password vault name. The new Galileo API key lives
# in the item named "EHR Assistant"; if that item stores the key in a named
# field rather than the default "credential", adjust the field accordingly.
# OpenAI and Postgres are separate secrets — point them at their own items.
# =============================================================================

DEFAULT_DOMAIN=healthcare

# ---- OpenAI (separate item) ----
OPENAI_API_KEY="{{ op://<VAULT>/OpenAI/credential }}"
OPENAI_DEFAULT_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=768

# ---- Galileo ----
# The new Galileo API key, in the 1Password item named "EHR Assistant".
GALILEO_API_KEY="{{ op://<VAULT>/EHR Assistant/credential }}"
# If the key is in a named field instead of the default "credential":
# GALILEO_API_KEY="{{ op://<VAULT>/EHR Assistant/API Key }}"
GALILEO_CONSOLE_URL=https://console.demo-v2.galileocloud.io/
GALILEO_PROJECT="EHR Assistant"
GALILEO_LOG_STREAM=chart-agent
AGENT_CONTROL_AGENT_NAME=ehr-assistant-agent
AGENT_CONTROL_RUNTIME_AUTH_MODE=jwt
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
AGENT_CONTROL_TARGET_TYPE=log_stream

# ---- PostgreSQL + pgvector (SHARED Neon backend) ----
# Same Neon URL as the main golden-demo deployment (already seeded — no re-init).
# Point this at wherever that URL is stored in 1Password (pooled URL).
POSTGRES_URL="{{ op://<VAULT>/Neon Postgres/connection string }}"

# ---- Optional ----
ADMIN_KEY=
ENVIRONMENT=hosted
