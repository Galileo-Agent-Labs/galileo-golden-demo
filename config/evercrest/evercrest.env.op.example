# =============================================================================
# Evercrest Health — 1Password `op inject` template
# =============================================================================
# Resolves the real secrets from 1Password into a private .env WITHOUT any key
# ever being typed or committed:
#
#   op signin
#   op inject -i config/evercrest/evercrest.env.op.example -o .env
#   chmod 600 .env
#
# Then run locally (python-dotenv picks up .env), or paste the equivalent values
# into Streamlit Cloud → Settings → Secrets (see .streamlit/secrets.evercrest.toml.template).
#
# ADJUST the vault name and field names on the right to match your 1Password.
# The item is named "evercrest-health" as requested; if it is a single
# API-credential item, its field is usually "credential" (shown as a fallback).
# =============================================================================

DEFAULT_DOMAIN=healthcare

# ---- OpenAI ----
OPENAI_API_KEY="{{ op://Galileo Demos/evercrest-health/OpenAI API Key }}"
OPENAI_DEFAULT_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=768

# ---- Galileo ----
# Primary: a named "Galileo API Key" field on the evercrest-health item.
GALILEO_API_KEY="{{ op://Galileo Demos/evercrest-health/Galileo API Key }}"
# Fallback if evercrest-health is a plain API-key item (one credential field):
# GALILEO_API_KEY="{{ op://Galileo Demos/evercrest-health/credential }}"
GALILEO_CONSOLE_URL=https://console.demo-v2.galileocloud.io/
GALILEO_PROJECT=evercrest-health
GALILEO_LOG_STREAM=healthcare
AGENT_CONTROL_AGENT_NAME=evercrest-health-agent
AGENT_CONTROL_RUNTIME_AUTH_MODE=jwt
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
AGENT_CONTROL_TARGET_TYPE=log_stream

# ---- PostgreSQL + pgvector ----
POSTGRES_URL="{{ op://Galileo Demos/evercrest-health/Postgres URL }}"

# ---- Optional ----
ADMIN_KEY=
ENVIRONMENT=hosted
